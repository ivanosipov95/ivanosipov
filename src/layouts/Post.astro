---
import Base from './Base.astro';

interface Props {
  frontmatter: {
    title: string;
    date: string;
    description?: string;
    tags?: string[];
  };
  rawContent?: () => string;
}

const { frontmatter, rawContent } = Astro.props;
const base = import.meta.env.BASE_URL;

const date = new Date(frontmatter.date).toLocaleDateString('ru-RU', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const readingTime = rawContent
  ? Math.max(1, Math.ceil(rawContent().split(/\s+/).length / 200))
  : null;
---

<Base title={frontmatter.title} description={frontmatter.description}>
  <article class="prose">
    <a href={`${base}articles`} class="back-link">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      Все статьи
    </a>

    <h1>{frontmatter.title}</h1>

    <div class="post-meta">
      <span class="post-date">{date}</span>
      {readingTime && <span class="post-reading-time">{readingTime} мин чтения</span>}
    </div>

    {frontmatter.tags && frontmatter.tags.length > 0 && (
      <div class="post-tags">
        {frontmatter.tags.map(tag => (
          <span class="post-tag">{tag}</span>
        ))}
      </div>
    )}

    <div class="post-content">
      <slot />
    </div>

    <div class="post-share">
      <span class="post-share-label">Поделиться:</span>
      <div class="post-share-buttons">
        <button class="share-btn" id="copy-link" aria-label="Скопировать ссылку">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          <span class="share-btn-text">Ссылка</span>
        </button>
        <a class="share-btn" id="share-telegram" target="_blank" rel="noopener" aria-label="Поделиться в Telegram">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4z"/><path d="M22 2 11 13"/></svg>
          <span class="share-btn-text">Telegram</span>
        </a>
      </div>
    </div>
  </article>
</Base>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    opacity: 0.5;
    margin-bottom: 2rem;
    transition: opacity 0.2s;
    border-bottom: none;
  }

  .back-link:hover {
    opacity: 1;
    border-bottom: none;
  }

  .prose h1 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    letter-spacing: -0.5px;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 0.85rem;
    opacity: 0.45;
    margin-bottom: 1rem;
  }

  .post-meta span + span::before {
    content: '·';
    margin-right: 0.8rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 2.5rem;
  }

  .post-tag {
    font-size: 0.75rem;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    background: var(--c-border);
    color: var(--c-fg-deep);
    opacity: 0.7;
  }

  .post-content {
    line-height: 1.8;
  }

  .post-content :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 0.8rem;
    font-size: 1.4rem;
    font-weight: 600;
  }

  .post-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.6rem;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .post-content :global(p) {
    margin-bottom: 1.2rem;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: 1.2rem;
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.3rem;
  }

  .post-content :global(a) {
    color: var(--c-fg-deep);
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 3px;
    transition: opacity 0.2s;
  }

  .post-content :global(a:hover) {
    opacity: 0.7;
  }

  .post-content :global(blockquote) {
    border-left: 3px solid var(--c-border);
    padding-left: 1rem;
    margin: 1.5rem 0;
    opacity: 0.8;
    font-style: italic;
  }

  .post-content :global(pre) {
    padding: 1.2rem;
    border-radius: 8px;
    margin: 1.5rem 0;
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .post-content :global(code:not(pre code)) {
    font-size: 0.85em;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    background: var(--c-border);
  }

  .post-content :global(img) {
    max-width: 100%;
    border-radius: 8px;
    margin: 1.5rem 0;
  }

  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9rem;
    display: block;
    overflow-x: auto;
  }

  .post-content :global(th),
  .post-content :global(td) {
    padding: 0.5rem 0.8rem;
    border-bottom: 1px solid var(--c-border);
    text-align: left;
    white-space: nowrap;
  }

  .post-content :global(th) {
    font-weight: 600;
    opacity: 0.6;
  }

  .post-content :global(hr) {
    border: none;
    border-top: 1px solid var(--c-border);
    margin: 2.5rem 0;
  }

  @media (max-width: 640px) {
    .prose h1 {
      font-size: 1.6rem;
    }

    .post-content :global(h2) {
      font-size: 1.2rem;
    }

    .post-content :global(pre) {
      font-size: 0.8rem;
      padding: 0.8rem;
    }

    .post-share {
      flex-wrap: wrap;
    }

    .share-btn-text {
      display: none;
    }
  }

  /* Share */
  .post-share {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-border);
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .post-share-label {
    font-size: 0.85rem;
    opacity: 0.4;
  }

  .post-share-buttons {
    display: flex;
    gap: 0.4rem;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.6rem;
    border-radius: 6px;
    font-size: 0.8rem;
    background: var(--c-border);
    color: var(--c-fg-deep);
    border: none;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
    text-decoration: none;
  }

  .share-btn:hover {
    background: var(--c-fg);
    color: var(--c-bg);
    border-bottom: none;
  }

  .share-btn.copied {
    background: #22c55e;
    color: #fff;
  }
</style>

<script>
  const url = window.location.href;
  const title = document.querySelector('.prose h1')?.textContent || '';

  document.getElementById('copy-link')?.addEventListener('click', (e) => {
    navigator.clipboard.writeText(url);
    const btn = e.currentTarget as HTMLElement;
    btn.classList.add('copied');
    const text = btn.querySelector('.share-btn-text');
    if (text) text.textContent = 'Скопировано';
    setTimeout(() => {
      btn.classList.remove('copied');
      if (text) text.textContent = 'Ссылка';
    }, 2000);
  });

  const tgLink = document.getElementById('share-telegram');
  if (tgLink) tgLink.setAttribute('href', `https://t.me/share/url?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`);
</script>
