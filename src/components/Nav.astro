---
import { features } from '../config/features';

const base = import.meta.env.BASE_URL;

const links = [
  ...(features.articles ? [{ href: `${base}articles`, text: 'Статьи' }] : []),
  ...(features.talks ? [{ href: `${base}talks`, text: 'Выступления' }] : []),
  ...(features.projects ? [{ href: `${base}projects`, text: 'Проекты' }] : []),
  { href: `${base}Осипов_Иван_CV.pdf`, text: 'Резюме', download: true },
];
---

<nav>
  <a href={base} class="logo" aria-label="Home">~/io</a>
  <div class="nav-right">
    {links.map(link => (
      <a href={link.href} class="nav-link" {...(link.download ? { download: '' } : {})}>{link.text}</a>
    ))}
    <a href="https://t.me/osipov_ivan" target="_blank" rel="noopener" class="nav-icon" aria-label="Telegram">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4z"/><path d="M22 2 11 13"/></svg>
    </a>
    <a href="mailto:ivan.osipov.job@gmail.com" class="nav-icon" aria-label="Email">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
    </a>
    <button id="theme-toggle" class="nav-icon theme-toggle" aria-label="Toggle theme">
      <svg class="sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      <svg class="moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </button>
  </div>
</nav>

<style>
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 0;
    margin-bottom: 3rem;
  }

  .logo {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--c-fg-deeper);
    border-bottom: none;
    font-style: italic;
    letter-spacing: -0.5px;
  }

  .logo:hover {
    color: var(--c-fg-deeper);
    border-bottom: none;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .nav-link {
    font-size: 0.9rem;
    color: var(--c-fg);
    opacity: 0.8;
    transition: opacity 0.2s;
  }

  .nav-link:hover {
    opacity: 1;
    border-bottom-color: transparent;
    color: var(--c-fg-deeper);
  }

  .nav-icon {
    color: var(--c-fg);
    opacity: 0.5;
    transition: opacity 0.2s;
    display: flex;
    align-items: center;
    border-bottom: none;
  }

  .nav-icon:hover {
    opacity: 1;
    border-bottom: none;
  }

  .theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  :global(html.dark) .sun { display: none; }
  :global(html:not(.dark)) .moon { display: none; }

  @media (max-width: 640px) {
    nav {
      padding: 1rem 0;
      margin-bottom: 1.5rem;
    }

    .nav-right {
      gap: 0.8rem;
    }

  }
</style>

<script is:inline>
  const theme = (() => {
    if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
      return localStorage.getItem('theme');
    }
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  })();

  if (theme === 'dark') {
    document.documentElement.classList.add('dark');
  }

  document.getElementById('theme-toggle')?.addEventListener('click', (e) => {
    const isDark = document.documentElement.classList.contains('dark');

    if (!document.startViewTransition) {
      document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'light' : 'dark');
      return;
    }

    const x = e.clientX;
    const y = e.clientY;
    const endRadius = Math.hypot(
      Math.max(x, innerWidth - x),
      Math.max(y, innerHeight - y)
    );

    document.documentElement.classList.add('theme-transitioning');

    const transition = document.startViewTransition(() => {
      document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'light' : 'dark');
    });

    transition.ready.then(() => {
      const small = 'circle(0px at ' + x + 'px ' + y + 'px)';
      const full = 'circle(' + endRadius + 'px at ' + x + 'px ' + y + 'px)';
      document.documentElement.animate(
        { clipPath: [small, full] },
        {
          duration: 400,
          easing: 'ease-in-out',
          pseudoElement: '::view-transition-new(root)',
        }
      );
    });

    transition.finished.then(() => {
      document.documentElement.classList.remove('theme-transitioning');
    });
  });
</script>
