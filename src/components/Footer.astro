---
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer>
  <div class="footer-links">
    <a href="https://t.me/osipov_ivan" target="_blank" rel="noopener" class="footer-link">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4z"/><path d="M22 2 11 13"/></svg>
      Telegram
    </a>
    <a href="mailto:ivan.osipov.job@gmail.com" class="footer-link">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
      ivan.osipov.job@gmail.com
    </a>
    <!--<a href={`${base}Осипов_Иван_CV.pdf`} download class="footer-link">-->
    <!--  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>-->
    <!--  Резюме-->
    <!--</a>-->
  </div>
  <p class="footer-copy">{year} &copy; Иван Осипов</p>
</footer>

<style>
  footer {
    margin-top: 6rem;
    padding: 2rem 0;
    text-align: center;
    font-size: 0.85rem;
  }

  .footer-links {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-bottom: 1rem;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--c-fg);
    opacity: 0.6;
    border-bottom: none;
    transition: opacity 0.2s;
  }

  .footer-link:hover {
    opacity: 1;
    border-bottom: none;
    color: var(--c-fg-deep);
  }

  .footer-copy {
    opacity: 0.4;
    margin: 0;
  }

  @media (max-width: 640px) {
    footer {
      margin-top: 4rem;
    }

    .footer-links {
      gap: 0.8rem;
      font-size: 0.8rem;
    }
  }
</style>
