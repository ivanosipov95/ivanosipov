---
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const talks = await Astro.glob('../../content/talks/*.md');
  return talks.map(talk => {
    const slug = talk.file.split('/').pop()?.replace('.md', '');
    return {
      params: { slug },
      props: { talk },
    };
  });
}

const base = import.meta.env.BASE_URL;
const { talk } = Astro.props;
const { title, event, date: dateStr, slides, video } = talk.frontmatter;
const { Content } = talk;

const date = new Date(dateStr).toLocaleDateString('ru-RU', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={`${title} — Иван Осипов`} description={`${title} — доклад на ${event}. ${date}.`}>
  <div class="talk-page">
    <a href={`${base}talks`} class="back-link">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      Все выступления
    </a>

    <h1>{title}</h1>

    <div class="talk-meta">
      <span class="talk-event">{event}</span>
      <span class="talk-date">{date}</span>
    </div>

    <div class="talk-description">
      <Content />
    </div>

    <div class="talk-links">
      {slides && (
        <a href={slides} target="_blank" rel="noopener" class="talk-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
          Презентация
        </a>
      )}
    </div>

    {video && (
      <div class="talk-video">
        <iframe
          src={video}
          title={title}
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        />
      </div>
    )}
  </div>
</Base>

<style>
  .talk-page {
    max-width: 720px;
    padding-top: 1rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    opacity: 0.5;
    margin-bottom: 2rem;
    transition: opacity 0.2s;
    border-bottom: none;
  }

  .back-link:hover {
    opacity: 1;
    border-bottom: none;
  }

  h1 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    letter-spacing: -0.5px;
  }

  .talk-meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 0.85rem;
    opacity: 0.45;
    margin-bottom: 1.5rem;
  }

  .talk-meta span + span::before {
    content: '\00b7';
    margin-right: 0.8rem;
  }

  .talk-description {
    line-height: 1.7;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .talk-links {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }

  .talk-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    background: var(--c-border);
    color: var(--c-fg-deep);
    font-size: 0.9rem;
    font-weight: 500;
    border-bottom: none;
    transition: background 0.2s, color 0.2s;
  }

  .talk-link:hover {
    background: var(--c-fg);
    color: var(--c-bg);
    border-bottom: none;
  }

  .talk-video {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: 8px;
  }

  .talk-video iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 1.6rem;
    }

    .talk-links {
      flex-direction: column;
    }

    .talk-link {
      justify-content: center;
    }
  }
</style>
