---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;

const testimonialFiles = await Astro.glob('../content/testimonials/*.md');
const testimonials = testimonialFiles.sort((a, b) => (a.frontmatter.order ?? 0) - (b.frontmatter.order ?? 0));

const skills = [
  { name: 'TypeScript', color: '#3178c6', icon: `${base}icons/typescript.svg` },
  { name: 'JavaScript', color: '#f7df1e', icon: `${base}icons/javascript.svg` },
  { name: 'CSS', color: '#1572b6', icon: `${base}icons/css.svg` },
  { name: 'React', color: '#61dafb', icon: `${base}icons/react.svg` },
  { name: 'Redux', color: '#764abc', icon: `${base}icons/redux.svg` },
  { name: 'React Query', color: '#ff4154', icon: `${base}icons/reactquery.svg` },
  { name: 'Angular', color: '#dd0031', icon: `${base}icons/angular.svg` },
  { name: 'Node.js', color: '#5fa04e', icon: `${base}icons/nodejs.svg` },
  { name: 'Express', color: '#000000', icon: `${base}icons/express.svg` },
  { name: 'Nest.js', color: '#e0234e', icon: `${base}icons/nestjs.svg` },
  { name: 'GraphQL', color: '#e10098', icon: `${base}icons/graphql.svg` },
  { name: 'Docker', color: '#2496ed', icon: `${base}icons/docker.svg` },
  { name: 'Vite', color: '#646cff', icon: `${base}icons/vite.svg` },
  { name: 'Webpack', color: '#8dd6f9', icon: `${base}icons/webpack.svg` },
  { name: 'Jest', color: '#c21325', icon: `${base}icons/jest.svg` },
  { name: 'Cypress', color: '#69d3a7', icon: `${base}icons/cypress.svg` },
  { name: 'NX', color: '#143055', icon: `${base}icons/nx.svg` },
  { name: 'ECharts', color: '#aa344d', icon: `${base}icons/echarts.svg` },
];

const certs = [
  { name: 'EpicReact.dev — React 19', year: '2021' },
  { name: 'Total TypeScript', year: '2023' },
  { name: 'Clean Coders — Architecture', year: '2023' },
  { name: 'Certified SAFe 5 Practitioner', year: '2023' },
  { name: 'Algorithms & Data Structures', year: '2024' },
];

const experience = [
  { role: 'Senior Frontend Engineer', company: 'Р7-Офис', period: '2025 — н.в.' },
  { role: 'Senior Frontend Engineer', company: 'Optimax Energy', period: '2023 — 2025' },
  { role: 'Lead Software Engineer', company: 'Solveva', period: '2021 — 2023' },
  { role: 'Senior Frontend Engineer', company: 'Sidenis', period: '2020 — 2021' },
  { role: 'Frontend Engineer', company: 'EPAM Systems', period: '2016 — 2020' },
];
---

<Base title="Ivan Osipov">
  <div class="home">
    <h1>Иван Осипов</h1>

    <p class="subtitle">Senior Software Engineer</p>

    <p>
      10 лет строю SaaS-продукты в FinTech, InsurTech и Energy — от архитектуры и разработки до настройки процессов и роста команды.
    </p>

    <p>
      Работал с продуктами для европейских энергорынков, крупнейших страховых компаний и редакторами документов мирового уровня.
      Помогаю бизнесу запускать сложные продукты быстрее, а разработчикам — расти профессионально.
    </p>

    <div class="section">
      <h2>Экспертиза</h2>
      <div class="expertise-grid">
        <div class="expertise-card">
          <h3>Архитектура фронтенда</h3>
          <p>Проектирование масштабируемых приложений, паттерны, декомпозиция модулей</p>
        </div>
        <div class="expertise-card">
          <h3>Full-stack разработка</h3>
          <p>Node.js, Express, Nest.js, GraphQL, базы данных, проектирование API</p>
        </div>
        <div class="expertise-card">
          <h3>Производительность</h3>
          <p>Web Vitals, профилирование, оптимизация рендеринга и сборки</p>
        </div>
        <div class="expertise-card">
          <h3>Тестирование</h3>
          <p>Стратегия тестирования, юнит- и E2E-тесты, Jest, Cypress, повышение надёжности продукта</p>
        </div>
        <div class="expertise-card">
          <h3>Миграции и рефакторинг</h3>
          <p>Перевод legacy-проектов на современный стек без остановки разработки</p>
        </div>
        <div class="expertise-card">
          <h3>Безопасность</h3>
          <p>CSP, защита от XSS/CSRF, аутентификация, OpenID Connect, криптография</p>
        </div>
        <div class="expertise-card">
          <h3>CI/CD и DevOps</h3>
          <p>Пайплайны, Docker, инкрементальные сборки, автоматизация релизов</p>
        </div>
        <div class="expertise-card">
          <h3>Монорепозитории</h3>
          <p>Масштабирование кодовых баз, NX, управление зависимостями</p>
        </div>
        <div class="expertise-card">
          <h3>Дизайн-системы</h3>
          <p>Проектирование компонентных библиотек, Storybook, единый UI-язык</p>
        </div>
        <div class="expertise-card">
          <h3>AI-агенты и LLM</h3>
          <p>Интеграция AI в рабочие процессы, автоматизация через агентов</p>
        </div>
        <div class="expertise-card">
          <h3>Agile / Scrum / Kanban</h3>
          <p>Выстраивание процессов разработки, SAFe-практики, координация команд</p>
        </div>
        <div class="expertise-card">
          <h3>Менторство и рост команды</h3>
          <p>Онбординг, код-ревью, развитие разработчиков, проведение собеседований</p>
        </div>
      </div>
    </div>

    <div class="section">
      <h2>Технологии</h2>
      <div class="tags">
        {skills.map(skill => (
          <span class="tag" style={`--tag-color: ${skill.color}`}>
            <img class="tag-icon" src={skill.icon} alt={skill.name} width="16" height="16" />
            {skill.name}
          </span>
        ))}
      </div>
    </div>

    <div class="section">
      <h2>Отзывы</h2>
      <div class="testimonials-wrapper">
        <div class="testimonials">
          {testimonials.map(t => (
            <blockquote class="testimonial">
              <div class="testimonial-quote">&ldquo;</div>
              <div class="testimonial-body">
                <div class="testimonial-text">
                  <t.Content />
                </div>
              </div>
              <footer class="testimonial-author">
                <span class="testimonial-name">{t.frontmatter.name}</span>
                {t.frontmatter.company && <span class="testimonial-company">{t.frontmatter.company}</span>}
                <span class="testimonial-role">{t.frontmatter.role}</span>
              </footer>
            </blockquote>
          ))}
        </div>
        <div class="testimonials-nav">
          <button class="testimonials-btn testimonials-prev" aria-label="Предыдущий отзыв">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button class="testimonials-btn testimonials-next" aria-label="Следующий отзыв">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
      </div>
    </div>

    <div class="section">
      <h2>Услуги</h2>
      <div class="services">
        <div class="service-card">
          <div class="service-header">
            <h3>Консультация</h3>
            <span class="service-price">3 000 ₽ / 60 мин</span>
          </div>
          <p class="service-desc">
            Разбор архитектурных решений, код-ревью, выбор технологий, карьерные вопросы — разовая сессия по любой теме.
          </p>
          <a href="https://calendlab.ru/c/consulting" target="_blank" rel="noopener" class="service-cta">
            Записаться
          </a>
        </div>

        <div class="service-card">
          <div class="service-header">
            <h3>Менторство</h3>
          </div>
          <div class="service-desc">
            <p class="service-format">
              <span class="format-info"><strong>Лайт</strong> — 2 встречи + чат для вопросов</span>
              <span class="format-price">5 000 ₽</span>
            </p>
            <p class="service-format">
              <span class="format-info"><strong>Стандарт</strong> — 4 встречи + код-ревью + чат</span>
              <span class="format-price">10 000 ₽</span>
            </p>
          </div>
          <a href="https://t.me/osipov_ivan" target="_blank" rel="noopener" class="service-cta">
            Написать в Telegram
          </a>
        </div>

        <div class="service-card">
          <div class="service-header">
            <h3>Ведение проекта</h3>
            <span class="service-price">по договорённости</span>
          </div>
          <p class="service-desc">
            Техническое руководство проектом: архитектура, код-ревью, настройка процессов, менторинг команды.
          </p>
          <a href="https://t.me/osipov_ivan" target="_blank" rel="noopener" class="service-cta">
            Написать в Telegram
          </a>
        </div>
      </div>
      <p class="services-note">
        По другим вопросам сотрудничества — <a href="mailto:ivan.osipov.job@gmail.com">ivan.osipov.job@gmail.com</a>
      </p>
    </div>


  </div>
</Base>

<style>
  .home {
    padding-top: 2rem;
    overflow: hidden;
    max-width: 100%;
  }

  .home h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 0.3rem;
    letter-spacing: -0.5px;
  }

  .subtitle {
    font-size: 1.1rem;
    opacity: 0.5;
    margin-bottom: 1.8rem;
  }

  .section {
    margin-top: 2.5rem;
  }

  .section h2 {
    font-size: 1.1rem;
    font-weight: 600;
    opacity: 0.35;
    margin-bottom: 0.8rem;
    margin-top: 0;
  }

  /* Experience */
  .experience-list {
    list-style: none;
    padding: 0;
  }

  .exp-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.35rem 0;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .exp-role {
    color: var(--c-fg-deep);
    font-weight: 500;
  }

  .exp-details {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    font-size: 0.85rem;
  }

  .exp-company {
    opacity: 0.6;
  }

  .exp-period {
    opacity: 0.35;
    white-space: nowrap;
  }

  /* Services */
  .services {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .service-card {
    display: flex;
    flex-direction: column;
    padding: 1.2rem;
    border: 1px solid var(--c-border);
    border-radius: 8px;
    transition: border-color 0.2s;
  }

  .service-card:hover {
    border-color: var(--c-fg);
  }

  .service-header {
    margin-bottom: 0.6rem;
  }

  .service-header h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--c-fg-deep);
    margin: 0 0 0.2rem;
  }

  .service-price {
    font-size: 0.85rem;
    opacity: 0.5;
  }

  .service-desc {
    font-size: 0.85rem;
    opacity: 0.7;
    line-height: 1.5;
    margin: 0 0 auto;
    padding-bottom: 1rem;
  }

  .service-format {
    display: flex;
    flex-direction: column;
    margin: 0 0 0.5rem;
  }

  .service-format:last-child {
    margin-bottom: 0;
  }

  .format-price {
    font-weight: 600;
    opacity: 1;
    white-space: nowrap;
  }

  .service-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem 0.8rem;
    border-radius: 6px;
    font-size: 0.85rem;
    background: var(--c-border);
    color: var(--c-fg-deep);
    border-bottom: none;
    transition: background 0.2s, color 0.2s;
    text-align: center;
    align-self: flex-start;
  }

  .service-cta:hover {
    background: var(--c-fg);
    color: var(--c-bg);
    border-bottom: none;
  }

  .services-note {
    margin-top: 1rem;
    font-size: 0.85rem;
    opacity: 0.5;
  }

  .services-note a {
    color: var(--c-fg-deep);
  }

  /* Tags */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.7rem;
    border-radius: 6px;
    font-size: 0.85rem;
    background: var(--c-border);
    color: var(--c-fg-deep);
    transition: background 0.2s, color 0.2s, border-color 0.2s;
    border: 1px solid transparent;
    cursor: default;
  }

  .tag:hover {
    border-color: var(--tag-color, var(--c-fg));
    background: color-mix(in srgb, var(--tag-color, var(--c-fg)) 10%, transparent);
  }

  :global(html.dark) .tag:hover {
    background: color-mix(in srgb, var(--tag-color, var(--c-fg)) 20%, var(--c-border));
  }

  .tag-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    display: block;
  }

  /* Testimonials */
  .testimonials-wrapper {
    position: relative;
  }

  .testimonials {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 0.5rem;
  }

  .testimonials::-webkit-scrollbar {
    display: none;
  }

  .testimonial {
    margin: 0;
    padding: 1.4rem;
    background: var(--c-border);
    border-radius: 10px;
    scroll-snap-align: start;
    min-width: calc(33.333% - 0.67rem);
    max-width: calc(33.333% - 0.67rem);
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
  }

  .testimonial-quote {
    font-size: 2.5rem;
    line-height: 1;
    font-weight: 700;
    opacity: 0.15;
    margin-bottom: 0.3rem;
    user-select: none;
  }

  .testimonial-body {
    flex: 1;
    margin-bottom: 1rem;
  }

  .testimonial-text {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--c-fg-deep);
    max-height: 7.5em;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .testimonial-text.expanded {
    max-height: none;
  }

  .testimonial-text :global(p) {
    margin: 0 0 0.5rem;
  }

  .testimonial-text :global(p:last-child) {
    margin-bottom: 0;
  }

  .testimonial-text :global(ul),
  .testimonial-text :global(ol) {
    margin: 0.3rem 0;
    padding-left: 1.2rem;
  }

  .testimonial-text :global(strong) {
    font-weight: 600;
  }

  .testimonial-body.truncated {
    position: relative;
    cursor: pointer;
  }

  .testimonial-body.truncated::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3rem;
    background: linear-gradient(transparent, var(--c-border));
    pointer-events: none;
    transition: opacity 0.2s;
  }

  .testimonial-body.truncated.expanded::after {
    opacity: 0;
  }

  .testimonial-author {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.8rem;
  }

  .testimonial-name {
    font-weight: 600;
    color: var(--c-fg-deep);
  }

  .testimonial-company {
    opacity: 0.6;
  }

  .testimonial-role {
    opacity: 0.45;
    font-size: 0.75rem;
  }

  .testimonials-nav {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.8rem;
  }

  .testimonials-btn {
    background: var(--c-border);
    border: none;
    border-radius: 50%;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--c-fg);
    opacity: 0.5;
    transition: opacity 0.2s, background 0.2s;
  }

  .testimonials-btn:hover {
    opacity: 1;
    background: var(--c-fg);
    color: var(--c-bg);
  }

  /* Expertise */
  .expertise-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .expertise-card {
    padding: 0.8rem 1rem;
    border: 1px solid var(--c-border);
    border-radius: 8px;
    transition: border-color 0.2s;
  }

  .expertise-card:hover {
    border-color: var(--c-fg);
  }

  .expertise-card h3 {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--c-fg-deep);
    margin: 0 0 0.3rem;
  }

  .expertise-card p {
    font-size: 0.8rem;
    opacity: 0.5;
    line-height: 1.4;
    margin: 0;
  }

  /* Certificates */
  .cert-list {
    list-style: none;
    padding: 0;
  }

  .cert-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.3rem 0;
    gap: 1rem;
  }

  .cert-name {
    color: var(--c-fg-deep);
    font-size: 0.95rem;
  }

  .cert-year {
    font-size: 0.85rem;
    opacity: 0.35;
    white-space: nowrap;
  }

  /* Contact */
  .contact-section {
    margin-top: 3rem;
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    font-size: 0.9rem;
    background: var(--c-border);
    border-bottom: none;
    color: var(--c-fg-deep);
    transition: background 0.2s, color 0.2s;
  }

  .social-links a:hover {
    background: var(--c-fg);
    color: var(--c-bg);
    border-bottom: none;
  }

  @media (max-width: 640px) {
    .home {
      padding-top: 0.5rem;
    }

    .home h1 {
      font-size: 1.8rem;
    }

    .subtitle {
      margin-bottom: 1.2rem;
    }

    .section {
      margin-top: 1.8rem;
    }

    .exp-item {
      flex-direction: column;
      gap: 0.1rem;
    }

    .exp-details {
      gap: 0.5rem;
    }

    .cert-item {
      flex-direction: column;
      gap: 0.1rem;
    }

    .cert-year {
      font-size: 0.8rem;
    }

    .services {
      grid-template-columns: 1fr;
    }

    .expertise-grid {
      grid-template-columns: 1fr;
    }

    .testimonial {
      min-width: 85%;
      max-width: 85%;
    }

    .tags {
      gap: 0.35rem;
    }

    .tag {
      padding: 0.25rem 0.55rem;
      font-size: 0.8rem;
    }

    .contact-section {
      margin-top: 2rem;
    }

    .social-links {
      gap: 0.4rem;
    }

    .social-links a {
      font-size: 0.85rem;
      padding: 0.3rem 0.6rem;
    }
  }
</style>

<script>
  // Carousel navigation
  const track = document.querySelector('.testimonials');
  const prevBtn = document.querySelector('.testimonials-prev');
  const nextBtn = document.querySelector('.testimonials-next');

  if (track && prevBtn && nextBtn) {
    const getScrollAmount = () => {
      const card = track.querySelector('.testimonial');
      if (!card) return 300;
      return card.offsetWidth + 16;
    };

    prevBtn.addEventListener('click', () => {
      track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
    });

    nextBtn.addEventListener('click', () => {
      track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
    });
  }

  // Expand/collapse long texts
  document.querySelectorAll('.testimonial-text').forEach(el => {
    if (el.scrollHeight > el.offsetHeight + 1) {
      const body = el.parentElement;
      body.classList.add('truncated');
      body.addEventListener('click', () => {
        el.classList.toggle('expanded');
        body.classList.toggle('expanded');
      });
    }
  });
</script>
