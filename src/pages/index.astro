---
import Base from '../layouts/Base.astro';

const skills = [
  { name: 'TypeScript', color: '#3178c6', icon: '/icons/typescript.svg' },
  { name: 'JavaScript', color: '#f7df1e', icon: '/icons/javascript.svg' },
  { name: 'CSS', color: '#1572b6', icon: '/icons/css.svg' },
  { name: 'React', color: '#61dafb', icon: '/icons/react.svg' },
  { name: 'Redux', color: '#764abc', icon: '/icons/redux.svg' },
  { name: 'React Query', color: '#ff4154', icon: '/icons/reactquery.svg' },
  { name: 'Angular', color: '#dd0031', icon: '/icons/angular.svg' },
  { name: 'Node.js', color: '#5fa04e', icon: '/icons/nodejs.svg' },
  { name: 'Express', color: '#000000', icon: '/icons/express.svg' },
  { name: 'Nest.js', color: '#e0234e', icon: '/icons/nestjs.svg' },
  { name: 'GraphQL', color: '#e10098', icon: '/icons/graphql.svg' },
  { name: 'Docker', color: '#2496ed', icon: '/icons/docker.svg' },
  { name: 'Vite', color: '#646cff', icon: '/icons/vite.svg' },
  { name: 'Webpack', color: '#8dd6f9', icon: '/icons/webpack.svg' },
  { name: 'Jest', color: '#c21325', icon: '/icons/jest.svg' },
  { name: 'Cypress', color: '#69d3a7', icon: '/icons/cypress.svg' },
  { name: 'NX', color: '#143055', icon: '/icons/nx.svg' },
  { name: 'ECharts', color: '#aa344d', icon: '/icons/echarts.svg' },
];

const certs = [
  { name: 'EpicReact.dev — React 19', year: '2021' },
  { name: 'Total TypeScript', year: '2023' },
  { name: 'Clean Coders — Architecture', year: '2023' },
  { name: 'Certified SAFe 5 Practitioner', year: '2023' },
  { name: 'Algorithms & Data Structures', year: '2024' },
];

const experience = [
  { role: 'Senior Frontend Engineer', company: 'Р7-Офис', period: '2025 — н.в.' },
  { role: 'Senior Frontend Engineer', company: 'Optimax Energy', period: '2023 — 2025' },
  { role: 'Lead Software Engineer', company: 'Solveva', period: '2021 — 2023' },
  { role: 'Senior Frontend Engineer', company: 'Sidenis', period: '2020 — 2021' },
  { role: 'Frontend Engineer', company: 'EPAM Systems', period: '2016 — 2020' },
];
---

<Base title="Ivan Osipov">
  <div class="home">
    <h1>Иван Осипов</h1>

    <p class="subtitle">Senior Frontend Engineer</p>

    <p>
      9+ лет в разработке SaaS-продуктов для FinTech и InsurTech.
      Специализируюсь на сложных продуктовых задачах, масштабировании кодовых баз и улучшении Developer Experience.
    </p>

    <p>
      Реализовал уникальный функционал, опередивший возможности Google Docs и MS Office Online.
      Ускорял сборки в 60 раз, внедрял монорепозитории, выстраивал CI/CD и дизайн-системы.
    </p>

    <p>
      Пишу статьи, выступаю на конференциях
      и менторю разработчиков.
    </p>

    <div class="section">
      <h2>Опыт</h2>
      <ul class="experience-list">
        {experience.map(exp => (
          <li class="exp-item">
            <span class="exp-role">{exp.role}</span>
            <span class="exp-details">
              <span class="exp-company">{exp.company}</span>
              <span class="exp-period">{exp.period}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>

    <div class="section">
      <h2>Технологии</h2>
      <div class="tags">
        {skills.map(skill => (
          <span class="tag" style={`--tag-color: ${skill.color}`}>
            <img class="tag-icon" src={skill.icon} alt={skill.name} width="16" height="16" />
            {skill.name}
          </span>
        ))}
      </div>
    </div>

    <div class="section">
      <h2>Сертификаты</h2>
      <ul class="cert-list">
        {certs.map(cert => (
          <li class="cert-item">
            <span class="cert-name">{cert.name}</span>
            <span class="cert-year">{cert.year}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="section contact-section">
      <h2>Контакт</h2>
      <div class="social-links">
        <a href="https://t.me/osipov_ivan" target="_blank" rel="noopener">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4z"/><path d="M22 2 11 13"/></svg>
          Телеграмм
        </a>
        <a href="mailto:ivan.osipov.job@gmail.com">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          Почта
        </a>
      </div>
    </div>
  </div>
</Base>

<style>
  .home {
    padding-top: 2rem;
    overflow: hidden;
    max-width: 100%;
  }

  .home h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 0.3rem;
    letter-spacing: -0.5px;
  }

  .subtitle {
    font-size: 1.1rem;
    opacity: 0.5;
    margin-bottom: 1.8rem;
  }

  .section {
    margin-top: 2.5rem;
  }

  .section h2 {
    font-size: 1.1rem;
    font-weight: 600;
    opacity: 0.35;
    margin-bottom: 0.8rem;
    margin-top: 0;
  }

  /* Experience */
  .experience-list {
    list-style: none;
    padding: 0;
  }

  .exp-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.35rem 0;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .exp-role {
    color: var(--c-fg-deep);
    font-weight: 500;
  }

  .exp-details {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    font-size: 0.85rem;
  }

  .exp-company {
    opacity: 0.6;
  }

  .exp-period {
    opacity: 0.35;
    white-space: nowrap;
  }

  /* Tags */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.7rem;
    border-radius: 6px;
    font-size: 0.85rem;
    background: var(--c-border);
    color: var(--c-fg-deep);
    transition: background 0.2s, color 0.2s, border-color 0.2s;
    border: 1px solid transparent;
    cursor: default;
  }

  .tag:hover {
    border-color: var(--tag-color, var(--c-fg));
    background: color-mix(in srgb, var(--tag-color, var(--c-fg)) 10%, transparent);
  }

  :global(html.dark) .tag:hover {
    background: color-mix(in srgb, var(--tag-color, var(--c-fg)) 20%, var(--c-border));
  }

  .tag-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    display: block;
  }

  /* Certificates */
  .cert-list {
    list-style: none;
    padding: 0;
  }

  .cert-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.3rem 0;
    gap: 1rem;
  }

  .cert-name {
    color: var(--c-fg-deep);
    font-size: 0.95rem;
  }

  .cert-year {
    font-size: 0.85rem;
    opacity: 0.35;
    white-space: nowrap;
  }

  /* Contact */
  .contact-section {
    margin-top: 3rem;
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    font-size: 0.9rem;
    background: var(--c-border);
    border-bottom: none;
    color: var(--c-fg-deep);
    transition: background 0.2s, color 0.2s;
  }

  .social-links a:hover {
    background: var(--c-fg);
    color: var(--c-bg);
    border-bottom: none;
  }

  @media (max-width: 640px) {
    .home {
      padding-top: 0.5rem;
    }

    .home h1 {
      font-size: 1.8rem;
    }

    .subtitle {
      margin-bottom: 1.2rem;
    }

    .section {
      margin-top: 1.8rem;
    }

    .exp-item {
      flex-direction: column;
      gap: 0.1rem;
    }

    .exp-details {
      gap: 0.5rem;
    }

    .cert-item {
      flex-direction: column;
      gap: 0.1rem;
    }

    .cert-year {
      font-size: 0.8rem;
    }

    .tags {
      gap: 0.35rem;
    }

    .tag {
      padding: 0.25rem 0.55rem;
      font-size: 0.8rem;
    }

    .contact-section {
      margin-top: 2rem;
    }

    .social-links {
      gap: 0.4rem;
    }

    .social-links a {
      font-size: 0.85rem;
      padding: 0.3rem 0.6rem;
    }
  }
</style>
