---
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  let events: any[] = [];
  try {
    events = await Astro.glob('../../content/events/*.md');
  } catch {}
  return events
    .filter(e => e.frontmatter.published !== false)
    .map(event => {
      const slug = event.file.split('/').pop()?.replace('.md', '');
      return {
        params: { slug },
        props: { event },
      };
    });
}

const base = import.meta.env.BASE_URL;
const { event } = Astro.props;
const { title, date: dateStr, location, registrationUrl } = event.frontmatter;
const { Content } = event;

const date = new Date(dateStr).toLocaleDateString('ru-RU', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={`${title} — Иван Осипов`} description={`${title} — ${date}${location ? `, ${location}` : ''}.`}>
  <div class="event-page">
    <a href={`${base}events`} class="back-link">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      Все мероприятия
    </a>

    <h1>{title}</h1>

    <div class="event-meta">
      <span class="event-date">{date}</span>
      {location && <span class="event-location">{location}</span>}
    </div>

    <div class="event-description">
      <Content />
    </div>

    {registrationUrl && (
      <div class="event-actions">
        <a href={registrationUrl} target="_blank" rel="noopener" class="event-register">
          Зарегистрироваться
        </a>
      </div>
    )}
  </div>
</Base>

<style>
  .event-page {
    max-width: 720px;
    padding-top: 1rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    opacity: 0.5;
    margin-bottom: 2rem;
    transition: opacity 0.2s;
    border-bottom: none;
  }

  .back-link:hover {
    opacity: 1;
    border-bottom: none;
  }

  h1 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    letter-spacing: -0.5px;
  }

  .event-meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 0.85rem;
    opacity: 0.45;
    margin-bottom: 1.5rem;
  }

  .event-meta span + span::before {
    content: '\00b7';
    margin-right: 0.8rem;
  }

  .event-description {
    line-height: 1.7;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .event-actions {
    margin-bottom: 2rem;
  }

  .event-register {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    background: var(--c-fg-deeper);
    color: var(--c-bg);
    font-size: 0.9rem;
    font-weight: 500;
    border-bottom: none;
    transition: opacity 0.2s;
  }

  .event-register:hover {
    opacity: 0.85;
    border-bottom: none;
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 1.6rem;
    }
  }
</style>
