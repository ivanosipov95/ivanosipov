---
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL;

let allEvents: any[] = [];
try {
  allEvents = await Astro.glob('../../content/events/*.md');
} catch {}
const now = new Date();
now.setHours(0, 0, 0, 0);

const upcoming = allEvents
  .filter(e => e.frontmatter.published !== false && new Date(e.frontmatter.date) >= now)
  .sort((a, b) => new Date(a.frontmatter.date).getTime() - new Date(b.frontmatter.date).getTime());
---

<Base title="Мероприятия — Иван Осипов" description="Ближайшие мастер-классы, воркшопы, лекции и доклады Ивана Осипова.">
  <div class="events-page">
    <h1>Мероприятия</h1>
    <p class="events-intro">Ближайшие мастер-классы, воркшопы, лекции и доклады.</p>

    {upcoming.length > 0 ? (
      <ul class="events-list">
        {upcoming.map(event => {
          const slug = event.file.split('/').pop()?.replace('.md', '');
          const date = new Date(event.frontmatter.date).toLocaleDateString('ru-RU', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          });
          return (
            <li>
              <a href={`${base}events/${slug}`} class="event-item">
                <div class="event-header">
                  <span class="event-title">{event.frontmatter.title}</span>
                  <span class="event-date">{date}</span>
                </div>
                <div class="event-meta">
                  {event.frontmatter.location && (
                    <span class="event-location">{event.frontmatter.location}</span>
                  )}
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    ) : (
      <div class="events-empty">
        <p>Пока нет запланированных мероприятий.</p>
      </div>
    )}
  </div>
</Base>

<style>
  .events-page h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .events-intro {
    opacity: 0.5;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .events-list {
    list-style: none;
    padding: 0;
  }

  .event-item {
    display: block;
    padding: 1rem 0;
    border-bottom: 1px solid var(--c-border);
    transition: opacity 0.2s;
  }

  .event-item:hover {
    opacity: 0.7;
  }

  li:last-child .event-item {
    border-bottom: none;
  }

  .event-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .event-title {
    color: var(--c-fg-deep);
    font-weight: 500;
    font-size: 1.05rem;
  }

  .event-date {
    font-size: 0.85rem;
    opacity: 0.4;
    white-space: nowrap;
  }

  .event-meta {
    margin-top: 0.3rem;
  }

  .event-location {
    font-size: 0.85rem;
    opacity: 0.5;
  }

  .events-empty {
    padding: 3rem 0;
    text-align: center;
  }

  .events-empty p {
    font-size: 1.05rem;
    opacity: 0.5;
    margin-bottom: 0.5rem;
  }

  .events-empty-hint {
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .events-page h1 {
      font-size: 1.6rem;
    }

    .event-header {
      flex-direction: column;
      gap: 0.1rem;
    }
  }
</style>
