---
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await Astro.glob('../../content/projects/*.md');
  return projects.map(project => {
    const slug = project.file.split('/').pop()?.replace('.md', '');
    return {
      params: { slug },
      props: { project },
    };
  });
}

const base = import.meta.env.BASE_URL;
const { project } = Astro.props;
const { title, description, url, github, stack, wip, screenshots, screenshotsDir } = project.frontmatter;
const { Content } = project;
---

<Base title={`${title} — Иван Осипов`} description={description}>
  <div class="project-page">
    <a href={`${base}projects`} class="back-link">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      Все проекты
    </a>

    <h1>{title}{wip && <span class="wip-badge">В разработке</span>}</h1>

    {stack && (
      <div class="project-stack">
        {stack.map((tech: string) => (
          <span class="stack-tag">{tech}</span>
        ))}
      </div>
    )}

    <div class="project-description">
      <Content />
    </div>

    {screenshots && (
      <div id="lightbox" class="lightbox" aria-hidden="true">
        <button class="lightbox-close" id="lightbox-close" aria-label="Закрыть">×</button>
        <button class="lightbox-nav lightbox-nav--prev" id="lightbox-prev" aria-label="Назад">←</button>
        <img class="lightbox-img" id="lightbox-img" src="" alt="" />
        <button class="lightbox-nav lightbox-nav--next" id="lightbox-next" aria-label="Вперёд">→</button>
        <div class="lightbox-counter" id="lightbox-counter"></div>
      </div>
    )}

    {screenshots && (
      <div class="carousel" id="carousel">
        <div class="carousel-track">
          {screenshots.map((s: { file: string; caption: string }, i: number) => (
            <div class={`carousel-slide${i === 0 ? ' active' : ''}`} data-index={i}>
              <img
                src={`${base}projects/${screenshotsDir}/${s.file}`}
                alt={s.caption}
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            </div>
          ))}
        </div>
        <div class="carousel-ui">
          <button class="carousel-btn" id="carousel-prev" aria-label="Назад">←</button>
          <span class="carousel-caption" id="carousel-caption">{screenshots[0].caption}</span>
          <span class="carousel-counter" id="carousel-counter">1 / {screenshots.length}</span>
          <button class="carousel-btn" id="carousel-next" aria-label="Вперёд">→</button>
        </div>
      </div>
    )}

    <div class="project-links">
      {url && (
        <a href={url} target="_blank" rel="noopener" class="project-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          Открыть проект
        </a>
      )}
      {github && (
        <a href={github} target="_blank" rel="noopener" class="project-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
          Исходный код
        </a>
      )}
    </div>
  </div>
</Base>

<style>
  .project-page {
    max-width: 720px;
    padding-top: 1rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    opacity: 0.5;
    margin-bottom: 2rem;
    transition: opacity 0.2s;
    border-bottom: none;
  }

  .back-link:hover {
    opacity: 1;
    border-bottom: none;
  }

  h1 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.8rem;
    letter-spacing: -0.5px;
  }

  .project-stack {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .stack-tag {
    font-size: 0.78rem;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    background: var(--c-border);
    color: var(--c-fg-deep);
    opacity: 0.7;
  }

  .project-description {
    line-height: 1.7;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .project-links {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    background: var(--c-border);
    color: var(--c-fg-deep);
    font-size: 0.9rem;
    font-weight: 500;
    border-bottom: none;
    transition: background 0.2s, color 0.2s;
  }

  .project-link:hover {
    background: var(--c-fg);
    color: var(--c-bg);
    border-bottom: none;
  }

  .wip-badge {
    font-size: 0.75rem;
    padding: 0.15rem 0.55rem;
    border-radius: 4px;
    background: var(--c-accent, #e8a735);
    color: #fff;
    font-weight: 600;
    margin-left: 0.6rem;
    vertical-align: middle;
    white-space: nowrap;
  }

  .carousel {
    margin-bottom: 2rem;
    user-select: none;
  }

  .carousel-track {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--c-border);
    background: var(--c-border);
    aspect-ratio: 16 / 9;
    cursor: zoom-in;
  }

  .carousel-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }

  .carousel-slide.active {
    opacity: 1;
    pointer-events: auto;
  }

  .carousel-slide img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .carousel-ui {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.6rem;
  }

  .carousel-btn {
    background: var(--c-border);
    border: none;
    color: var(--c-fg);
    width: 2rem;
    height: 2rem;
    border-radius: 4px;
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    transition: background 0.15s;
    flex-shrink: 0;
  }

  .carousel-btn:hover {
    background: var(--c-fg);
    color: var(--c-bg);
  }

  .carousel-caption {
    flex: 1;
    font-size: 0.82rem;
    opacity: 0.55;
  }

  .carousel-counter {
    font-size: 0.78rem;
    opacity: 0.35;
    flex-shrink: 0;
  }

  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.92);
    align-items: center;
    justify-content: center;
    cursor: zoom-out;
  }

  .lightbox.open {
    display: flex;
  }

  .lightbox-img {
    max-width: 95vw;
    max-height: 92vh;
    object-fit: contain;
    border-radius: 4px;
    pointer-events: none;
  }

  .lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    background: none;
    border: none;
    color: #fff;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 0.15s;
    z-index: 1;
  }

  .lightbox-close:hover { opacity: 1; }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255,255,255,0.1);
    border: none;
    color: #fff;
    font-size: 1.5rem;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.15s, background 0.15s;
    z-index: 1;
  }

  .lightbox-nav:hover {
    opacity: 1;
    background: rgba(255,255,255,0.2);
  }

  .lightbox-nav--prev { left: 1.25rem; }
  .lightbox-nav--next { right: 1.25rem; }

  .lightbox-counter {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    color: #fff;
    font-size: 0.8rem;
    opacity: 0.45;
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 1.6rem;
    }

    .project-links {
      flex-direction: column;
    }

    .project-link {
      justify-content: center;
    }

    .lightbox-nav {
      display: none;
    }

    .lightbox-img {
      max-width: 100vw;
      max-height: 85vh;
    }

    .lightbox-counter {
      bottom: 1.5rem;
    }
  }
</style>

<script>
  const slides = document.querySelectorAll<HTMLElement>('.carousel-slide');
  const caption = document.getElementById('carousel-caption');
  const counter = document.getElementById('carousel-counter');
  const total = slides.length;

  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;

  if (total > 0) {
    const captions = Array.from(slides).map(s => s.querySelector('img')?.alt ?? '');
    const srcs = Array.from(slides).map(s => s.querySelector('img')?.src ?? '');
    let current = 0;

    const lightboxCounter = document.getElementById('lightbox-counter');

    function go(n: number) {
      slides[current].classList.remove('active');
      current = (n + total) % total;
      slides[current].classList.add('active');
      if (caption) caption.textContent = captions[current];
      if (counter) counter.textContent = `${current + 1} / ${total}`;
      if (lightbox?.classList.contains('open') && lightboxImg) {
        lightboxImg.src = srcs[current];
        lightboxImg.alt = captions[current];
        if (lightboxCounter) lightboxCounter.textContent = `${current + 1} / ${total}`;
      }
    }

    document.getElementById('carousel-prev')?.addEventListener('click', () => go(current - 1));
    document.getElementById('carousel-next')?.addEventListener('click', () => go(current + 1));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') go(current - 1);
      if (e.key === 'ArrowRight') go(current + 1);
      if (e.key === 'Escape') closeLightbox();
    });

    // Lightbox open
    document.querySelector('.carousel-track')?.addEventListener('click', () => {
      if (lightbox && lightboxImg) {
        lightboxImg.src = srcs[current];
        lightboxImg.alt = captions[current];
        if (lightboxCounter) lightboxCounter.textContent = `${current + 1} / ${total}`;
        lightbox.classList.add('open');
        document.body.style.overflow = 'hidden';
      }
    });

    function closeLightbox() {
      lightbox?.classList.remove('open');
      document.body.style.overflow = '';
    }

    lightbox?.addEventListener('click', closeLightbox);
    document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);

    // Lightbox prev/next — останавливаем всплытие чтобы не закрывать
    document.getElementById('lightbox-prev')?.addEventListener('click', (e) => {
      e.stopPropagation();
      go(current - 1);
    });
    document.getElementById('lightbox-next')?.addEventListener('click', (e) => {
      e.stopPropagation();
      go(current + 1);
    });

    // Свайп — общая функция
    function addSwipe(el: Element | null, onLeft: () => void, onRight: () => void) {
      if (!el) return;
      let startX = 0;
      el.addEventListener('touchstart', (e) => {
        startX = (e as TouchEvent).touches[0].clientX;
      }, { passive: true });
      el.addEventListener('touchend', (e) => {
        const dx = (e as TouchEvent).changedTouches[0].clientX - startX;
        if (Math.abs(dx) > 40) dx < 0 ? onLeft() : onRight();
      }, { passive: true });
    }

    addSwipe(document.querySelector('.carousel-track'), () => go(current + 1), () => go(current - 1));
    addSwipe(lightboxImg, () => go(current + 1), () => go(current - 1));
  }
</script>
